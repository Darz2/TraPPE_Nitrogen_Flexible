#---------------------------- NPT simulations  ---------------------------------------------------------------------#

fix runnpt all npt temp ${simulationTemp} ${simulationTemp} 10 iso ${pressure} ${pressure} 100
fix runnpt all npt temp 300 ${simulationTemp} 10 iso ${pressure} ${pressure} 100
fix runnpt all npt temp 300 300 10 iso ${pressure} ${pressure} 100
fix runnpt all npt temp 300 300 10 iso 177.66 ${pressure} 100
fix runnpt all npt temp 300 300 10 iso 177.66 177.66 100

thermo_style custom step pe ke etotal press temp v_Density
thermo_modify flush yes
thermo ${thermo_num}
thermo 1000

velocity all create ${simulationTemp} ${RandomSeed} mom yes rot yes dist gaussian
velocity all create 300 ${RandomSeed} mom yes rot yes dist gaussian
velocity all create 300 47000 mom yes rot yes dist gaussian

#-----------------------
# Run (Pre-Initialization)
#-----------------------

timestep    0.1
run         ${Ninptpre}
run         50000
