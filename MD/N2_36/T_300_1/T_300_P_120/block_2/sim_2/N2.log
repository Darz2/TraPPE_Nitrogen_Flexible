units		    real
atom_style	    full
boundary        p p p
pair_style	    lj/cut/coul/long 12
pair_modify     mix arithmetic tail yes
kspace_style    pppm 1e-6
bond_style      harmonic
angle_style     harmonic

read_data       ./data.lmp           # read the positions --------------comment it out for restarting
