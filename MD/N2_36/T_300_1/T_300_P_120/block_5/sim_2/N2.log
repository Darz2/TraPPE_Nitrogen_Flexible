  read_data CPU = 0.180 seconds
#read_restart   2.restart

#----------------------------------------------------------------------------#
# FORCEFIELD - TraPPE Flexible model for N2
#----------------------------------------------------------------------------#

pair_coeff      1   1  0.0695521435  3.310  # [N2]-L-[N2]
pair_coeff      2   2  0.0009936 0.5   # N2-[L]

bond_coeff      1   500 0.55            # [N2]-[L]

angle_coeff     1   50 180              # N2-N2_X-N2

mass 1 13.9067      # N2
mass 2  0.1         # N2_X

set type        1   charge     -0.482             # N2
Setting atom values ...
  1000 settings made for charge
set type        2   charge      0.964             # N2_X
Setting atom values ...
  500 settings made for charge

#------------------------ VARIABLES------------------------------------------#

variable  TEMP_INDEX       equal 300  # in K
variable  PRESS_INDEX      equal 120  # in bar
variable  RandomSeed       equal 20000  # RANDOM SEED
variable  nz_layers        equal 20
variable  nx_layers        equal 3
variable  timestep         equal 0.5

variable  simulationTemp   equal ${TEMP_INDEX}
variable  simulationTemp   equal 300
variable  pressure         equal 0.987*${PRESS_INDEX}
variable  pressure         equal 0.987*120

variable  Ninptpre         equal 50000
variable  Ninpt            equal 400000     # 0.2 ns
variable  npt_run          equal 2000000    # 1 ns
variable  NBR              equal ${npt_run}/100
variable  NBR              equal 2000000/100

variable  Density          equal density
variable  Volume           equal vol

variable  dumpfreq         equal 1000
variable  thermofreq       equal 1000
variable  printfreq        equal 1000
variable  restartfreq      equal 1000000

variable  NVT_init         equal 200000    # 0.1 ns
variable  NVT_init_2       equal 200000    # 0.1 ns
variable  NVE_reshape      equal 10000
variable  NVT_prod         equal 1000000   # 0.5 ns
variable  NVE_cuboid       equal 200000    # 0.1 ns

variable  thermo_num       equal 1000

#---------------------------- GROUPS/NEIGHBOUR - LIST -----------------------------------------------------------------------#

group           oxy  type 1
1000 atoms in group oxy
group           carb type 2
500 atoms in group carb

neighbor	    3.0 bin
neigh_modify    every 1 delay 0 check yes
run_style       verlet

#---------------------------- CONGUGATE-GRADIENT MINIMIZATION --------------------------------------------------------#

